{
  "name": "wework-desktop",
  "description": "Secure desktop host for WeWork",
  "author": "WeWork",
  "desktopName": "wework.desktop",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "electron src/main.mjs",
    "test": "node --test",
    "bundle:runtime": "node src/build-runtime.mjs",
    "package:dir": "npm run bundle:runtime && electron-builder --dir --config.electronDist=../node_modules/electron/dist",
    "package:linux-arm64": "npm run bundle:runtime && electron-builder --linux deb AppImage --arm64",
    "package:mac": "npm run bundle:runtime && electron-builder --mac",
    "package:win": "npm run bundle:runtime && electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "gpt-tokenizer": "3.4.0"
  },
  "build": {
    "appId": "app.wework.desktop",
    "productName": "WeWork",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime-dist",
        "to": "wework-app-runtime"
      },
      {
        "from": "../dist",
        "to": "wework-ui"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Office",
      "executableName": "wework",
      "syncDesktopName": true,
      "artifactName": "wework-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "packageName": "wework",
      "maintainer": "WeWork",
      "synopsis": "wework digital employee collaboration desktop"
    }
  },
  "license": "GPL-3.0-only"
}
